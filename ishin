                        local untilGuard=(trigger-position)/track.Speed
                        if untilGuard>0 and untilGuard<=0.45 then
                            local score=(attack.critical and 100 or 0)-untilGuard*100-distance
                            if not preparationCandidate or score>preparationCandidate.score then
                                preparationCandidate={target=target.part,untilGuard=untilGuard,score=score,critical=attack.critical}
                            end
                        end
                        if position > latest then continue end
                        if position >= trigger then
                            candidates[#candidates+1] = {target=target.part, track=track, attack=attack, position=position, delay=trigger/track.Speed, approaching=approaching, score=(attack.critical and 100 or 0)+(position-trigger)/track.Speed*100-distance}
                        end
                    end
                end
            end
        end
    end
    local count = 0
    for _ in nearbyAttackers do count += 1 end
    state.threats = count
    if preparationCandidate and canDefend then
        if preparingUntil<=now then state.preparations+=1 end
        preparingUntil=math.max(preparingUntil,now+preparationCandidate.untilGuard+0.06)
        pauseAttack()
        prepareGuardMovement()
        if releaseAt==0 or preparationCandidate.critical then faceThreat(root,ownHum,preparationCandidate.target) end
    end
    if count>0 then
        if data.InSafeZone~=true and data.Stance=='' and now>=nextStanceRequest then
            nextStanceRequest=now+1
            local ok=pcall(function() remote:FireServer('Stance') end)
            if ok then state.stanceRequests+=1 end
        end
    end
    if not canDefend then
        preparingUntil=0
        if releaseAt>0 then release() else restoreFacing() resumeAttack() end
        return
    end
    if releaseAt==0 and now>=preparingUntil then resumeAttack() end
    if #candidates == 0 or now < nextAction or releaseAt>now then return end
    table.sort(candidates, function(a,b) return a.score>b.score end)
    local chosen = candidates[1]
    if chosen.approaching then state.dashDetections += 1 end
    local running = ownHum.MoveDirection.Magnitude > 0.1 and root.AssemblyLinearVelocity.Magnitude > 8
    local attacking = tick < (data.M1LockUntil or 0) or tick < (data.M1CooldownUntil or 0) or data.ActionLock == true
    local weave = not chosen.attack.critical and not attacking and not pendingBlock and not data.IsBlocking and data.StanceHasWeave and tick >= (data.WeaveCooldownUntil or 0)
    state.running, state.attacking = running, attacking
    if facingTarget and facingTarget ~= chosen.target then state.targetSwitches += 1 end
    faceThreat(root, ownHum, chosen.target)
    state.turns += 1
    pauseAttack()
    prepareGuardMovement()
    currentRequest={attack=chosen.attack.name,critical=chosen.attack.critical,serverTime=tick,oldWeaveWindow=data.WeaveWindow or 0,oldWeaveState=data.WeaveState or 0,hardStop=now+0.32,guardAccepted=false,weaveAccepted=false,running=running,locked=data.ActionLock==true,stunned=serverStunUntil('FullStun',data)>tick or serverStunUntil('HardStun',data)>tick,softStun=serverStunUntil('SoftStun',data)>tick,stance=data.Stance,position=chosen.position}
    state.stats.requests+=1
    if chosen.attack.critical then state.stats.criticalRequests+=1 end
    if running then state.stats.runningRequests+=1 end
    acknowledged=false
    state.recentActions[#state.recentActions+1]=currentRequest
    if #state.recentActions>12 then table.remove(state.recentActions,1) end
    local ok, err = pcall(nativePress,nil,nil,nil)
    local combat=registry:get('ControlTable').Combat
    local pulseTime=math.max(chosen.attack.critical and state.heavyGuardTime or state.normalGuardTime,combat.WeaveInvuln or 0.25)
    nextAction = now + math.max(pulseTime+state.guardGap,combat.BlockCooldown or 0.175)
    if not ok then state.errors += 1 state.lastError = tostring(err) restoreFacing() resumeAttack() return end
    seen[chosen.track] = {position=chosen.position}
    state.attempts += 1
    if weave then state.weaves += 1 else state.blocks += 1 end
    state.lastAttack, state.lastTriggerPosition = chosen.attack.name, chosen.position
    state.lastDelay=chosen.delay
    state.lastMode, state.lastTarget = chosen.attack.critical and 'Native critical guard' or 'Native guard', chosen.target.Parent.Name
    releaseAt = now + pulseTime
    if not weave then
        if not pendingBlock then acknowledged = false end
        pendingBlock = true
        nextBlockSend = now + 0.05
        state.recentBlocks[#state.recentBlocks+1] = {attack=chosen.attack.name,position=chosen.position,acknowledged=data.IsBlocking==true,stunned=(data.FullStun or 0)>tick or (data.SoftStun or 0)>tick,actionLock=data.ActionLock,health=ownHum.Health,running=running,attacking=attacking,threats=count,approaching=chosen.approaching,stance=data.Stance}
        if #state.recentBlocks>8 then table.remove(state.recentBlocks,1) end
    end
    pendingBlock=true
    refresh()
end
