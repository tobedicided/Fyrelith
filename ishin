local stunKeys={'FullStun','HardStun','SoftStun','GoalWalkSpeed','OverrideWalkSpeed','JumpLockAfter','OverrideJumpPower'}
clearAntiStun=function()
    if not antiSource then return end
    for _,c in antiSource.connections do c:Disconnect() end
    for key in antiSource.dirty do antiSource.replica.Data[key]=antiSource.values[key] end
    antiSource=nil
end
local function updateAntiStun(current)
    if not current or type(current.Data)~='table' then clearAntiStun() return end
    if not antiSource or antiSource.replica~=current then
        clearAntiStun()
        local source={replica=current,values={},connections={},dirty={}}
        antiSource=source
        local watched={}
        for _,key in stunKeys do
            watched[key]=true
            source.values[key]=current.Data[key]
        end
        source.connections[1]=current:ListenToRaw(function(method,path,value)
            if method=='SetValue' and #path==1 and watched[path[1]] then source.values[path[1]]=value
            elseif method=='SetValues' and #path==0 and type(value)=='table' then
                for key,v in value do if watched[key] then source.values[key]=v end end
            end
        end)
    end
    local source=antiSource
    local d=current.Data
    local tick=getTick()
    local stunned=math.max(source.values.FullStun or 0,source.values.HardStun or 0,source.values.SoftStun or 0)>tick
    state.serverStunned=stunned
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass('Humanoid')
    local active=state.antiStun and stunned and humanoid and humanoid.Health>0 and not d.Downed and (d.Ragdoll or 0)<=tick
    if active then
        for _,key in {'FullStun','HardStun','SoftStun','JumpLockAfter'} do d[key]=0 source.dirty[key]=true end
        if not d.IsBlocking then
            d.GoalWalkSpeed=math.max(source.values.GoalWalkSpeed or 0,d.WalkSpeed or 7)
            source.dirty.GoalWalkSpeed=true
            if source.values.OverrideWalkSpeed==0 then d.OverrideWalkSpeed=-1 source.dirty.OverrideWalkSpeed=true end
            if source.values.OverrideJumpPower==0 then d.OverrideJumpPower=-1 source.dirty.OverrideJumpPower=true end
        end
        state.antiStunFrames+=1
    else
        for key in source.dirty do d[key]=source.values[key] end
        table.clear(source.dirty)
    end
end
local nextMovementUpdate=0
table.insert(state.connections,run.PreSimulation:Connect(function()
