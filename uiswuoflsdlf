-- Always-on idle protection, independent of UI visibility and game-data loading.
do
 local environment=getgenv()
 local player=game:GetService('Players').LocalPlayer
 while not player do task.wait(.1) player=game:GetService('Players').LocalPlayer end
 local previous=environment.FyrelithAntiAFK
 if not (previous and previous.Alive and previous.Player==player and previous.IdledConnection and previous.IdledConnection.Connected) then
  if previous and previous.Cleanup then pcall(previous.Cleanup) end
  local input=game:GetService('UserInputService')
  local virtualUser=game:GetService('VirtualUser')
  local anti={Alive=true,Player=player,Pulses=0,LastInput=os.clock(),LastPulse=-math.huge,Busy=false,Connections={}}
  environment.FyrelithAntiAFK=anti
  local function listen(signal,callback)
   local connection=signal:Connect(callback) table.insert(anti.Connections,connection) return connection
  end
  function anti.Pulse()
   if not anti.Alive or anti.Busy or os.clock()-anti.LastPulse<20 then return false end
   anti.Busy=true
   local camera=workspace.CurrentCamera
   local frame=camera and camera.CFrame or CFrame.new()
   local ok,err=pcall(function()
    virtualUser:CaptureController()
    virtualUser:Button2Down(Vector2.zero,frame)
    task.wait(.05)
    virtualUser:Button2Up(Vector2.zero,frame)
   end)
   if not ok then
    -- Release even if a controller operation failed midway.
    pcall(virtualUser.Button2Up,virtualUser,Vector2.zero,frame)
    ok,err=pcall(function()
     local manager=game:GetService('VirtualInputManager')
     local position=input:GetMouseLocation()
     manager:SendMouseMoveEvent(position.X+1,position.Y,game)
     manager:SendMouseMoveEvent(position.X,position.Y,game)
    end)
    if ok then anti.Method='VirtualInputManager' end
   else anti.Method='VirtualUser' end
   anti.LastAttempt=os.clock()
   if ok then anti.Pulses+=1 anti.LastPulse=anti.LastAttempt anti.LastError=nil
   else anti.LastError=tostring(err) end
   anti.Busy=false
   return ok
  end
  local function activity() anti.LastInput=os.clock() end
  listen(input.InputBegan,activity)
  listen(input.InputChanged,activity)
  anti.IdledConnection=listen(player.Idled,function() task.spawn(anti.Pulse) end)
  function anti.Cleanup()
   anti.Alive=false
   for _,connection in ipairs(anti.Connections) do connection:Disconnect() end
  end
  task.spawn(function()
   while anti.Alive and player.Parent do
    task.wait(30)
    if anti.Alive and os.clock()-anti.LastInput>=90 and os.clock()-anti.LastPulse>=60 then anti.Pulse() end
   end
   anti.Cleanup()
  end)
 end
