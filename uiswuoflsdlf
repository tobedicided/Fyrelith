 local previous=environment.FyrelithIdleRecovery
 if not (previous and previous.Alive and previous.Player==player and previous.Job==game.JobId and previous.Version==1) then
  if previous and previous.Cleanup then pcall(previous.Cleanup) end
  local guiService=game:GetService('GuiService')
  local teleport=game:GetService('TeleportService')
  local recovery={Version=1,Alive=true,Player=player,Job=game.JobId,Pending=false,Attempts=0,Connections={},Status='Watching for idle disconnect'}
  environment.FyrelithIdleRecovery=recovery
  local idleCode
  pcall(function() idleCode=Enum.ConnectionError.DisconnectIdle.Value end)
  local function listen(signal,callback) local c=signal:Connect(callback) table.insert(recovery.Connections,c) return c end
  function recovery.IsIdleDisconnect(message,code)
   local text=tostring(message or ''):lower()
   if text:find('banned',1,true) or text:find('suspended',1,true) or text:find('moderation',1,true) or text:find('exploit',1,true) or text:find('cheat',1,true) then return false end
   local value=typeof(code)=='EnumItem' and code.Value or tonumber(code)
   if idleCode and value==idleCode then return true end
   local idle=text:find('idle',1,true) or text:find('inactiv',1,true) or text:find('afk',1,true) or text:find('ไม่ได้ใช้งาน',1,true)
   local disconnected=text:find('disconnect',1,true) or text:find('kick',1,true) or text:find('20 minute',1,true) or text:find('ถูกตัด',1,true)
   return idle~=nil and disconnected~=nil
  end
  function recovery.Destination()
   local preferences=player.PlayerGui:FindFirstChild('FyrelithUIOnlyPreferences')
   local root=preferences and tonumber(preferences:GetAttribute('ExperienceRoot_'..game.GameId))
   if root and root>0 then return root end
   local ready=environment.FyrelithGameReady
   if ready and ready.Loader then
    local ok,settings=pcall(ready.Loader.load_data,script,'GameplaySettings')
    if ok and type(settings)=='table' and tonumber(settings.LOBBY_PLACE_ID) then return tonumber(settings.LOBBY_PLACE_ID) end
   end
   return game.PlaceId
  end
  function recovery.RetryDelay(attempt) return math.min(30,3*2^math.max(0,attempt-1)) end
  local function saveBeforeReconnect()
   local macro=environment.FyrelithMacro
   if macro and macro.Alive and (macro.State=='Recording' or macro.State=='Finishing' or (macro.State=='Paused' and macro.BeforePause=='Recording')) then pcall(macro.Save) end
   local runtime=environment.FyrelithRuntime
   if runtime and runtime.Save then pcall(runtime.Save) end
   local source=environment.FyrelithScriptSource
   if type(source)=='string' and type(writefile)=='function' then
    recovery.ScriptSaved=pcall(writefile,'FyrelithRuntime.luau',source)
   end
   recovery.ResumeQueued=environment.FyrelithTeleportQueued==true
  end
  local function recover(message,code)
   if not recovery.Alive or recovery.Pending or not recovery.IsIdleDisconnect(message,code) then return end
   local key=tostring(code)..':'..tostring(message)
   if recovery.Handled==key then return end
   recovery.Handled=key recovery.Pending=true recovery.Attempts=0 recovery.Departing=false
   recovery.Reason=tostring(message) recovery.Status='Idle disconnect detected'
   saveBeforeReconnect()
   task.spawn(function()
    while recovery.Alive and recovery.Pending and recovery.Attempts<4 do
     task.wait(recovery.RetryDelay(recovery.Attempts+1))
     if not recovery.Alive or not recovery.Pending or recovery.Departing then return end
     recovery.Attempts+=1 recovery.Failed=false recovery.Status='Reconnecting after idle disconnect'
     saveBeforeReconnect()
     local destination=recovery.Destination() recovery.PlaceId=destination
     local ok,err=pcall(function() teleport:Teleport(destination,player) end)
     if not ok then recovery.LastError=tostring(err) recovery.Failed=true end
     local deadline=os.clock()+20
     while recovery.Alive and recovery.Pending and not recovery.Failed and not recovery.Departing and os.clock()<deadline do task.wait(.25) end
     if recovery.Departing then recovery.Status='Joining lobby' return end
    end
    if recovery.Alive then recovery.Pending=false recovery.Status='Reconnect attempts exhausted' end
   end)
  end
  listen(player.OnTeleport,function(state)
   if not recovery.Pending then return end
   if state==Enum.TeleportState.Failed then recovery.Failed=true
   elseif state==Enum.TeleportState.InProgress then recovery.Departing=true end
  end)
  listen(teleport.TeleportInitFailed,function(who,_,message)
   if recovery.Pending and who==player then recovery.Failed=true recovery.LastError=tostring(message) end
  end)
  local function readError()
   local ok,message=pcall(function() return guiService:GetErrorMessage() end)
   local codeOK,code=pcall(function() return guiService:GetErrorCode() end)
   return ok and message or '',codeOK and code or nil
  end
  pcall(function()
   recovery.ErrorConnection=listen(guiService.ErrorMessageChanged,function(message)
    local _,code=readError() recover(message,code)
   end)
  end)
  function recovery.Cleanup()
   recovery.Alive=false recovery.Pending=false
   for _,c in ipairs(recovery.Connections) do c:Disconnect() end
  end
  task.spawn(function()
   while recovery.Alive and player.Parent do
    local message,code=readError()
    recovery.ErrorMonitorAvailable=code~=nil
    if message~='' or (idleCode and typeof(code)=='EnumItem' and code.Value==idleCode) then recover(message,code) end
    task.wait(2)
   end
   recovery.Cleanup()
  end)
 end
end

