 function a.ValidateAutoAction(step,unit,kind)
  local priority=env.FyrelithAprilUnits
  if step.Action=='Place'and type(Loader.LevelData)=='table'and Loader.LevelData.id=='april2_event'and priority and priority.Enabled and priority.Rejected[step.UnitId]then return false,'Placement cancelled · unit is in Discard list' end
