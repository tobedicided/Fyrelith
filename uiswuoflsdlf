   if e.stat=='damage' then return 'effect:damage' end
   if e.stat=='range' then return 'effect:range' end
   if e.stat=='attack_cooldown' or e.stat=='spa' then return 'effect:cooldown' end
   if e.stat=='active_attack_cooldown' then return 'effect:ability' end
  end
  return 'effect:'..tostring(e.type)
 end
 function a.CardSafety(choice)
  local good,bad,unknown=0,0,0
  for _,e in pairs(choice.effects or {})do
   local t=e.type local n=tonumber(e.amount)or 0 local s=a.ScoreEffects({e},false)
   local known=t=='ui_evidence' or t=='candy_multiplier' or t=='secret_drop' or t=='resource_gain' or t=='boss_damage' or t=='unit_cost' or t=='stat_mul' or t=='stat_add' or t=='stat_attr_add' or t=='stat_mul_real' or t=='new_path' or t=='random_effects' or tostring(t):sub(1,6)=='enemy_'
   if e._kind=='Bad' or e.target=='enemy' and n>0 or e.enemy==true and n>0 then bad+=1
   elseif not known or e._kind=='Unknown' then unknown+=1
   elseif s<0 then bad+=1 elseif s>0 then good+=1 end
  end
  if bad>0 then return good>0 and 1 or 0 end
  if choice.option_type=='Bad' then return 0 end
  if good>0 then return 3 end
  if choice.option_type=='Good' or choice.option_type=='Resource' then return 2 end
