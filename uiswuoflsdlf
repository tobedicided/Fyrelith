 function a.ScoreEffects(effects,danger)
  local score=0
  for _,e in pairs(effects or {}) do
   local n=tonumber(e.amount) or 0 local t=e.type local stat=e.stat
   if t=='ui_evidence' then score+=tonumber(e._score)or 0
   elseif t=='candy_multiplier' then score+=n*(danger and 35 or 140)
   elseif t=='secret_drop' then score+=n*(danger and 20 or 90)
   elseif t=='resource_gain' then score+=math.min(30,n/250)
   elseif t=='boss_damage' then score+=n*(danger and 150 or 80)
   elseif t=='unit_cost' then score-=n*120
   elseif t=='stat_mul' or t=='stat_add' or t=='stat_attr_add' then
    score+=n*((stat=='spa' or stat=='attack_cooldown' or stat=='active_attack_cooldown' or stat=='cost') and -160 or stat=='damage' and 160 or stat=='range' and 90 or 35)
   elseif t=='stat_mul_real' then score+=(n-1)*((stat=='attack_cooldown' or stat=='active_attack_cooldown') and -160 or 160)
   elseif t=='enemy_stat_mul' then score-=n*((stat=='health' or stat=='hp') and 200 or 100)
   elseif t=='enemy_speedup' then score-=n*240
   elseif t=='enemy_regen' then score-=n*500
   elseif t=='enemy_shield' then score-=n*30
   elseif t=='enemy_resistance_specific' then score-=n*2
   elseif t=='enemy_bomb' then score-=n*8
   elseif t=='enemy_passive_chance' then score-=n*180
   elseif t=='new_path' then score-=#(e.new_lanes or {})*250
   elseif t=='random_effects' then score+=(e._type=='Good' and 15 or -65)*n*(tonumber(e.tier) or 1)
   else score-=40 end
  end
  return score
 end
 local function effectKey(e)
